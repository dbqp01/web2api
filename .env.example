# Set these in the local process environment; this file is not auto-loaded.
# Default: real USGAR public read-only adapter, no upstream credentials required.
# To opt into the synthetic laboratory instead, set both variables below:
# WEB2API_ORIGIN=http://127.0.0.1:4318
# WEB2API_RECIPE=.local/recipe.json
# Required for serving REST; supply a locally generated secret, never commit it.
WEB2API_API_KEY=
# Optional upstream bearer; not included in recipes, tool output or logs.
WEB2API_UPSTREAM_TOKEN=
# Standalone app: optional port and directory for verified learned workflows.
# WEB2API_PORT=4319
# WEB2API_WORKFLOWS=C:/Users/your-user/AppData/Local/Web2API/workflows
